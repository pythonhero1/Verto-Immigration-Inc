---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';
---
<Layout title="Staff intake workspace" noindex><PageHero eyebrow="VERTO STAFF" title="Registration workspace." text="Authorized staff can review incoming enquiries and update intake status. Access is protected by Cloudflare Access."/><section class="section container"><div class="actions" style="margin:0 0 25px"><button id="load-records" class="button" type="button">Load registrations</button><button id="next-records" class="button outline" type="button" hidden>Next page →</button></div><p id="admin-status" role="status"></p><div id="admin-list"></div><section id="admin-record" class="info-panel" style="margin-top:35px" hidden><h2 style="font-size:30px" id="detail-reference"></h2><dl id="detail-payload" class="review-list"></dl><form id="update-record"><div class="field"><label for="staff-status">Intake status</label><select id="staff-status" name="status"><option value="received">Registration received</option><option value="reviewing">Under review</option><option value="contacted">Follow-up in progress</option><option value="awaiting_payment">Request agreed service payment</option><option value="in_progress">Service in progress</option><option value="closed">Intake closed</option></select></div><label class="check-field"><input type="checkbox" id="terms-confirmed"/><span>I confirm the applicant has agreed the written service scope, CAD $622 total fee, merchant identity and refund terms. This must be confirmed before requesting payment.</span></label><button class="button" type="submit">Save intake update</button></form></section></section><script src="../scripts/admin.ts"></script></Layout>

---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import Icon from '../components/Icon.astro';import {site} from '../data/site';
---
<Layout title="Contact Verto"><PageHero eyebrow="LET’S TALK" title="A conversation is a good first step." text="Ask about your plans, our services, fees or the online registration process."/><section class="section container"><div class="contact-grid"><div class="contact-card"><Icon name="mail" size={30}/><h2>Write to us</h2><p>Tell us briefly what you would like help with. Please do not email passport copies or financial records.</p><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-card"><Icon name="phone" size={30}/><h2>Let’s have a conversation</h2><p>Speak to Verto about work permit and visa support, service scope and the next step.</p><a href={`tel:${site.tel}`}>{site.phone}</a></div></div><div class="split-content" style="margin-top:60px"><div><h2>Ready to tell us a little more?</h2><p>Our guided registration takes you through the details that help us understand your starting point. You can review everything before submitting.</p><a class="button" href="/register/">Start your registration →</a></div><aside class="info-panel"><h3>Connect with Verto</h3><p>{site.consultant}<br/>College ID {site.collegeId}</p><p><a href={site.register} target="_blank" rel="noopener noreferrer">Verify representative details ↗</a></p><a href={site.facebook} target="_blank" rel="noopener noreferrer" class="underlink">Visit our Facebook page ↗</a></aside></div></section></Layout>

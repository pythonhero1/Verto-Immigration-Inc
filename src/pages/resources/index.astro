---
import Layout from '../../layouts/Layout.astro';import PageHero from '../../components/PageHero.astro';import CTA from '../../components/CTA.astro';
const articles=[['before-you-apply','GETTING STARTED','Before you begin your registration','A few useful details to prepare for a focused first conversation.'],['verify-your-representative','MAKE INFORMED CHOICES','Verify your immigration representative','Use official sources to check who you are working with.'],['documents-and-privacy','PROTECT YOUR INFORMATION','A thoughtful approach to your documents','Understand what to share at intake and what should wait.']];
---
<Layout title="Immigration planning resources"><PageHero eyebrow="PLANNING RESOURCES" title="Start informed. Move thoughtfully." text="Practical preparation for a clearer conversation about your Canadian immigration plans."/><section class="section container"><div class="reading-grid">{articles.map(([slug,label,title,text])=><a href={`/resources/${slug}/`} class="reading-card"><span>{label}</span><h2>{title}</h2><p>{text}</p><span class="underlink">Read the guide ↗</span></a>)}</div><div class="notice">These guides explain how to prepare for Verto’s service. For current immigration rules, forms, fees and processing information, use <a href="https://www.canada.ca/en/immigration-refugees-citizenship.html" target="_blank" rel="noopener noreferrer">Immigration, Refugees and Citizenship Canada ↗</a>.</div></section><CTA/></Layout>

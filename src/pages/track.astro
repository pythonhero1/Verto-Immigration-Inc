---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';
---
<Layout title="Track your registration" noindex><PageHero eyebrow="PRIVATE REGISTRATION TRACKING" title="Your first step. Your next update." text="Check your Verto intake using the reference and access key shown after registration. This is separate from official IRCC application tracking."/><div class="status-card"><form id="track-form"><h2>Find your registration.</h2><div class="field"><label for="reference">Registration reference</label><input id="reference" name="reference" placeholder="VERTO-…" required autocomplete="off" pattern="VERTO-[A-Fa-f0-9]{12}"/></div><div class="field"><label for="accessKey">Private access key</label><input type="password" id="accessKey" name="accessKey" required autocomplete="off" minlength="64" maxlength="64"/></div><button type="submit" class="button" style="margin-top:25px">Check registration →</button></form><div id="track-status" class="form-status" role="status"></div><section id="track-result" hidden><span class="eyebrow">YOUR VERTO INTAKE</span><h2 id="result-reference"></h2><p><span class="status-badge" id="result-status"></span></p><div id="result-details"></div><div class="notice">Verto will contact you about your request. This status refers to your service enquiry with Verto and does not indicate a government immigration decision.</div><div id="payment-offer" hidden><h3>Your agreed service payment</h3><p>Verto has recorded that your service terms are confirmed. Review your written agreement before paying.</p><p id="merchant"></p><label class="check-field"><input id="payment-consent" type="checkbox"/><span>I have agreed the service scope, CAD $622 total fee, merchant identity and refund terms with Verto. I understand payment does not guarantee approval.</span></label><button id="pay" class="button" type="button">Open secure on-site checkout →</button><div id="checkout" style="margin-top:25px"></div><div id="payment-message" role="status" class="form-status"></div></div><div class="actions"><button id="refresh" class="text-button" type="button">Refresh status</button><button id="clear-tracking" class="text-button" type="button">Clear private link from this page</button></div></section><p class="privacy-note">Lost your reference or access key? <a href="/contact/">Contact Verto</a> for help. Keep your tracking link private.</p></div><script src="../scripts/track.ts"></script></Layout>

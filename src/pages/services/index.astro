---
import Layout from '../../layouts/Layout.astro';import PageHero from '../../components/PageHero.astro';import CTA from '../../components/CTA.astro';import Icon from '../../components/Icon.astro';import {services} from '../../data/site';
---
<Layout title="Work permit & visitor visa services"><PageHero eyebrow="OUR SERVICES" title="Your plans. A path forward." text="Personal support for work permit and visitor visa applications, beginning with a clear understanding of your circumstances."/><section class="section container"><div class="service-grid">{services.map(s=><a class="service-card" href={`/services/${s.slug}/`}><div class="card-top"><span>{s.number} / {s.short.toUpperCase()}</span><Icon name={s.icon} size={32}/></div><h2 style="font-size:32px">{s.title}</h2><p>{s.description}</p><div class="card-bottom"><span>Explore this service</span><Icon/></div></a>)}</div><div class="notice">Considering a different immigration pathway? <a href="/contact/">Contact Verto</a> to confirm whether your request is within our service scope before registering.</div></section><CTA/></Layout>

---
import Layout from '../../layouts/Layout.astro';import PageHero from '../../components/PageHero.astro';import CTA from '../../components/CTA.astro';import {services} from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}))}const {service:s}=Astro.props;
---
<Layout title={s.title} description={s.description}><PageHero eyebrow={s.short.toUpperCase()} title={s.title} text={s.description}><div class="actions"><a class="button" href={`/register/?service=${encodeURIComponent(s.label)}`}>Start your registration →</a><a class="underlink" href="/contact/">Speak to Verto first ↗</a></div></PageHero><section class="section container split-content"><div><span class="eyebrow">SUPPORT THAT STARTS WITH YOU</span><h2>{s.intro}</h2><p>{s.body}</p><h3>What we can help with</h3><ul class="check-list">{s.items.map(i=><li>{i}</li>)}</ul><div class="notice">Requirements depend on your circumstances and can change. Registration is not an eligibility decision or an application to IRCC. No approval, job offer or processing timeline is guaranteed.</div><h3>A useful starting point</h3><p>You do not need every document to have an initial conversation. The following details help us understand your plans:</p><ul class="check-list">{s.prepare.map(i=><li>{i}</li>)}</ul><a href={s.official} target="_blank" rel="noopener noreferrer" class="underlink">Read current Government of Canada guidance ↗</a></div><aside class="info-panel"><span class="eyebrow">BEFORE YOU COMMIT</span><h3>Understand your service.</h3><p>Verto will discuss the support available for your circumstances. Confirm the agreed work, fee, refund terms and any government costs before paying.</p><a class="underlink" href="/fees/">Fees & service scope ↗</a><hr style="border:0;border-top:1px solid var(--line);margin:28px 0"/><h3>Questions are welcome.</h3><p>Start with a conversation if you are unsure which service you need.</p><a class="button" href="/contact/">Contact Verto →</a></aside></section><CTA/></Layout>

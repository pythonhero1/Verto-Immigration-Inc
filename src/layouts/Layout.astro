---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {site} from '../data/site';
const {title='Canadian immigration, with a clear way forward',description='Personal work permit and visitor visa support from Verto Immigration Inc. Explore your options, understand the process and register online.',noindex=false}=Astro.props;
const path=Astro.url.pathname;
const nav=[['Services','/services/'],['Our approach','/how-it-works/'],['About Verto','/about/'],['Resources','/resources/']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#092c41"/><title>{title} | Verto Immigration Inc.</title><meta name="description" content={description}/><link rel="canonical" href={new URL(path,Astro.site)}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:title" content={`${title} | Verto Immigration Inc.`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL('/images/toronto.webp',Astro.site)}/>{noindex&&<meta name="robots" content="noindex,nofollow"/>}</head>
<body><a class="skip" href="#main">Skip to content</a>
<div class="topbar"><div class="container"><span>YOUR NEXT CHAPTER STARTS WITH A CONVERSATION</span><div><a href={`tel:${site.tel}`}>{site.phone}</a><span class="top-divider"></span><a href="/track/">Track registration <span aria-hidden="true">↗</span></a></div></div></div>
<header class="header"><div class="container header-inner"><a class="brand" href="/" aria-label="Verto Immigration Inc. home"><img src="/images/verto-logo.jpeg" width="138" height="92" alt="Verto Immigration Inc."/></a><button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="navigation"><Icon name="menu"/></button><nav id="navigation" aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={path.startsWith(url)?'page':undefined}>{label}</a>)}<a href="/contact/" class="nav-contact">Contact</a><a class="button small" href="/register/">Start your journey <Icon size={16}/></a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="container footer-main"><div class="footer-brand"><a href="/" class="wordmark">VERTO<span>IMMIGRATION INC.</span></a><p>Big ambitions.<br/>A considered way forward.</p><a href={site.facebook} class="social" aria-label="Visit Verto on Facebook" target="_blank" rel="noopener noreferrer"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 22v-9h3l.5-4H14V7c0-1.2.4-2 2-2h2V1.4A26 26 0 0 0 15 1c-3 0-5 1.8-5 5v3H7v4h3v9z"/></svg></a></div><div><h2>Explore</h2><a href="/services/work-permits/">Work in Canada</a><a href="/services/visitor-visas/">Visit Canada</a><a href="/how-it-works/">How it works</a><a href="/fees/">Fees & service scope</a></div><div><h2>Here to help</h2><a href="/about/">About Verto</a><a href="/faq/">Frequently asked questions</a><a href="/resources/">Planning resources</a><a href="/track/">Track registration</a></div><div class="footer-contact"><h2>Let’s talk about your plans</h2><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:${site.tel}`}>{site.phone}</a><p>Immigration contact<br/><strong>{site.consultant}</strong></p><a href={site.register} target="_blank" rel="noopener noreferrer">College ID {site.collegeId} · View register ↗</a></div></div><div class="container footer-note"><p>Verto is a private immigration service business, independent of the Government of Canada. Registration is an intake request. Immigration authorities determine eligibility and outcomes.</p><div><span>© {new Date().getFullYear()} Verto Immigration Inc.</span><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/refunds/">Refunds</a><a href="/accessibility/">Accessibility</a></div></div></div></footer>
<script>const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector('#navigation');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Close navigation':'Open navigation');nav?.classList.toggle('open',open)});document.addEventListener('keydown',e=>{if(e.key==='Escape'){toggle?.setAttribute('aria-expanded','false');nav?.classList.remove('open')}});</script>
</body></html>

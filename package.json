{"name":"verto-immigration-astro","version":"1.0.0","private":true,"type":"module","scripts":{"dev":"astro dev --host 0.0.0.0","build":"astro build","preview":"astro preview --host 0.0.0.0","check":"astro check && tsc --noEmit -p tsconfig.functions.json","test":"node --import tsx --test tests/*.test.ts","pages:dev":"npm run build && wrangler pages dev dist","deploy":"npm run build && wrangler pages deploy dist","db:local":"wrangler d1 migrations apply verto-intake --local","db:remote":"wrangler d1 migrations apply verto-intake --remote"},"dependencies":{"@fontsource/dm-sans":"^5.2.8","@fontsource/instrument-serif":"^5.2.8","astro":"7.4.11","jose":"^6.1.0","stripe":"23.1.0","zod":"^4.3.0"},"devDependencies":{"@astrojs/check":"^0.9.8","@cloudflare/workers-types":"latest","@types/node":"^24.19.2","tsx":"^4.20.0","typescript":"^5.9.3","wrangler":"4.160.1"}}